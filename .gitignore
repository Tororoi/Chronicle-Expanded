# Clip recordings: videos, their sound and frames, and the event logs. scripts/port/record_clip.py works in a
# temporary folder and the harness writes under port/run/clips/ (ignored below); these catch one written anywhere else.
*.mp4
*.mov
*.webm
*.gif
*.wav
*.mp3
*.m4a
*.y4m
[0-9][0-9][0-9][0-9][0-9][0-9].png
ticks.txt
*.events.jsonl
*.sheet.png

# Build files
/build/
/ps2/build/*
/port/build/*
/port/run/
!/ps2/build/.gitkeep
!/port/build/.gitkeep

# Android/Gradle local caches, downloaded build tools, and generated packages.
/port/android/.gradle/
/port/android/.gradle-home/
/port/android/.cxx/
/port/android/app/.cxx/
/port/android/build/
/port/android/app/build/
/port/android/app/libs/*.aar
/port/android/host-tools/glslang.exe
/port/android/app/src/main/jniLibs/*/libSDL3.so
/port/android/*.log

# Reference assembly, split from the disc by splat and never committed: one
# tree per release, ps2/asm/ntsc and ps2/asm/pal.
/ps2/asm/

# A checkout of the private repository; see scripts/host/overlay_private.sh.
/.private/

# Generated by the objdiff target from the address index and provenance
objdiff.json

# The objdiff progress report, regenerated by CI on every push
progress/

/re/*
!/re/MWCC.md

# Doxygen output
doxygen/

# Python cache
**/__pycache__

# IDA files
*.id0
*.id1
*.id2
*.nam
*.til

# Mips2C context
ctx.c

# AI
CLAUDE.md
AGENTS.md
.claude
.codex/

# IDA databases (derived from binaries already in-tree)
*.i64
*.idb

# Kazarov's state: configuration locks and run descriptors.
/.kazarov/

# The PC port's extracted game data and its saves; see docs/PC_PORT_PLAN.md.
/data/
/save/
/soundtrack/

# The game's message files exported as JSON (darkcloud --export-text, docs/LOCALIZATION.md): the
# disc's own text, never committed.
/lang-export/

# Flatpak builds (docs/FLATPAK.md)
/.flatpak-builder/
/build-dir/
/repo/
/chronicle.flatpak

# MacOS
.DS_Store
